# Runtime only. Copy to .env; never use VITE_* or build arguments for credentials.
SONARR_URL=http://sonarr.example.invalid:8989
SONARR_API_KEY=replace-with-your-key
RADARR_URL=http://radarr.example.invalid:7878
RADARR_API_KEY=replace-with-your-key
SONARR_MONITORED_ONLY=true
RADARR_MONITORED_ONLY=true
# Empty allowlists publish nothing. Remove a line to publish all monitored IDs.
SONARR_ALLOW_IDS=
RADARR_ALLOW_IDS=
REFRESH_INTERVAL_MINUTES=15
DAYS_BACK=30
DAYS_AHEAD=180
REQUEST_TIMEOUT_MS=10000
# Optional mounted files or existing JSON:
# SONARR_API_KEY_FILE=/run/secrets/sonarr-key
# CALENDAR_CONFIG=/run/config/exporter.json
# PUBLIC_CONFIG_FILE=/run/config/public-config.json
# CALENDAR_UID=1000
# CALENDAR_GID=1000
# CALENDAR_ICON_URL=https://example.com/calendar.png
# CALENDAR_DEMO=true
